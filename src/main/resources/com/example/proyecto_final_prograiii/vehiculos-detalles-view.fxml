<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.proyecto_final_prograiii.controllers.VehiculosDetallerController"
            prefHeight="420.0" prefWidth="640.0">

    <children>
        <VBox spacing="12" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10" >
            <HBox spacing="10">
                <Label text="Detalle del Vehículo" style="-fx-font-size:18px; -fx-font-weight:bold;" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrar"/>
            </HBox>

            <HBox spacing="20">
                <!-- placeholder imagen -->
                <ImageView fx:id="imgCarro" fitWidth="260" fitHeight="160" preserveRatio="true"/>

                <VBox spacing="6">
                    <Label fx:id="lblModelo" text="Modelo: " />
                    <Label fx:id="lblPlaca" text="Placa: " />
                    <Label fx:id="lblTipo" text="Tipo: " />
                    <Label fx:id="lblAnio" text="Año: " />
                    <Label fx:id="lblColor" text="Color: " />
                    <Label fx:id="lblKm" text="Kilometraje: " />
                    <Label fx:id="lblEstado" text="Estado: " />
                    <Label fx:id="lblFechaCreacion" text="Fecha de creación: " />
                </VBox>
            </HBox>

            <HBox spacing="8">
                <Button fx:id="btnReservar" text="Reservar" onAction="#reservar"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
