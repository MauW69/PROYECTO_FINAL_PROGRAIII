<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="root-panel"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_final_prograiii.controllers.PanelClienteController">

    <children>
        <!-- Tabla de alquileres (oculta al inicio) -->
        <TableView fx:id="tblAlquileres" layoutX="10.0" layoutY="52.0" prefHeight="520.0" prefWidth="880.0"
                   visible="false" styleClass="table-alquileres" AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="52.0" AnchorPane.bottomAnchor="10.0">
            <columns>
                <TableColumn fx:id="colModelo" prefWidth="200.0" text="VEHICULO" />
                <TableColumn fx:id="colPlaca" prefWidth="160.0" text="PLACA" />
                <TableColumn fx:id="inicio" prefWidth="180.0" text="FECHA INICIO" />
                <TableColumn fx:id="fin" prefWidth="180.0" text="FECHA FINAL" />
                <TableColumn fx:id="total" prefWidth="120.0" text="TOTAL" />
                <TableColumn fx:id="colDetalle" prefWidth="90.0" text="DETALLES" />
            </columns>

        </TableView>

        <!-- BARRA SUPERIOR -->
        <HBox layoutX="0.0" layoutY="0.0" prefHeight="56.0" prefWidth="900.0" styleClass="top-bar"
              alignment="CENTER_LEFT" spacing="12.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>

            <Label fx:id="lblBienvenida" styleClass="titulo-bienvenida" text="Bienvenido/a — Vehículos disponibles" HBox.hgrow="ALWAYS" />

            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volver" styleClass="btn-secondary" text="Volver" visible="false" managed="false" />

            <Button fx:id="misAlquileres" mnemonicParsing="false" onAction="#mostrarMisAlquileres" styleClass="btn-primary" text="MIS ALQUILERES" />

            <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-logout" text="Cerrar sesión" />
        </HBox>

        <!-- SCROLLER GENERAL -->
        <ScrollPane fx:id="scroll" layoutX="10.0" layoutY="60.0" prefHeight="530.0" prefWidth="880.0"
                    styleClass="scroll-vehiculos" fitToWidth="true"
                    AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">

            <content>
                <!-- CONTENEDOR GRID 4x4 (FlowPane para que las cards fluyan y hagan wrap) -->
                <FlowPane fx:id="cardsContainer"
                          styleClass="cards-wrapper"
                          hgap="24.0" vgap="24.0"
                          prefWrapLength="880.0"
                          alignment="TOP_CENTER">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                    </padding>

                    <!-- Las tarjetas las inserta dinámicamente el controlador -->
                </FlowPane>
            </content>

        </ScrollPane>
    </children>

</AnchorPane>
