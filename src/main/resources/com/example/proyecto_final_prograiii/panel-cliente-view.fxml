<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_final_prograiii.controllers.PanelClienteController">

    <children>

        <!-- TITULO / BIENVENIDA -->
        <Label fx:id="lblBienvenida" layoutX="20.0" layoutY="14.0" style="-fx-font-size:18.0px; -fx-font-weight:bold;" text="Bienvenido/a — Vehículos disponibles" />

        <!-- BOTÓN CERRAR SESIÓN -->
        <Button fx:id="btnCerrarSesion" layoutX="720.0" layoutY="10.0" mnemonicParsing="false" onAction="#cerrarSesion" prefHeight="28.0" prefWidth="160.0" text="Cerrar sesión" />

        <!-- SCROLLER GENERAL -->
        <ScrollPane layoutX="10.0" layoutY="51.2" prefHeight="539.0" prefWidth="890.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="51.0">

            <content>

                <!-- CONTENEDOR DE LAS 5 CARDS -->
                <HBox fx:id="cardsContainer" spacing="20.0" style="-fx-padding:20.0;">

                    <!-- CARD 1 -->
                    <VBox fx:id="card1" prefWidth="240.0" spacing="10.0" style="-fx-background-color:#ffffff; -fx-border-color:#e6e6e6; -fx-border-radius:10.0; -fx-background-radius:10.0; -fx-padding:12.0;">

                        <!-- ESPACIO PARA IMAGEN -->
                        <Region prefHeight="120.0" style="-fx-background-color:#f4f4f4; -fx-border-radius:8.0; -fx-background-radius:8.0;" />

                        <Label fx:id="lblCarro1Title" style="-fx-font-weight:bold; -fx-font-size:15.0px;" text="Modelo — Placa" />

                        <Label fx:id="lblCarro1Info" style="-fx-font-size:12.0px;" text="Información" wrapText="true" />

                    </VBox>


                    <!-- CARD 2 -->
                    <VBox fx:id="card2" prefWidth="240.0" spacing="10.0" style="-fx-background-color:#ffffff; -fx-border-color:#e6e6e6; -fx-border-radius:10.0; -fx-background-radius:10.0; -fx-padding:12.0;">

                        <Region prefHeight="120.0" style="-fx-background-color:#f4f4f4; -fx-border-radius:8.0; -fx-background-radius:8.0;" />

                        <Label fx:id="lblCarro2Title" style="-fx-font-weight:bold; -fx-font-size:15.0px;" text="Modelo — Placa" />

                        <Label fx:id="lblCarro2Info" style="-fx-font-size:12.0px;" text="Información" wrapText="true" />

                    </VBox>


                    <!-- CARD 3 -->
                    <VBox fx:id="card3" prefWidth="240.0" spacing="10.0" style="-fx-background-color:#ffffff; -fx-border-color:#e6e6e6; -fx-border-radius:10.0; -fx-background-radius:10.0; -fx-padding:12.0;">

                        <Region prefHeight="120.0" style="-fx-background-color:#f4f4f4; -fx-border-radius:8.0; -fx-background-radius:8.0;" />

                        <Label fx:id="lblCarro3Title" style="-fx-font-weight:bold; -fx-font-size:15.0px;" text="Modelo — Placa" />

                        <Label fx:id="lblCarro3Info" style="-fx-font-size:12.0px;" text="Información" wrapText="true" />

                    </VBox>


                    <!-- CARD 4 -->
                    <VBox fx:id="card4" prefWidth="240.0" spacing="10.0" style="-fx-background-color:#ffffff; -fx-border-color:#e6e6e6; -fx-border-radius:10.0; -fx-background-radius:10.0; -fx-padding:12.0;">

                        <Region prefHeight="120.0" style="-fx-background-color:#f4f4f4; -fx-border-radius:8.0; -fx-background-radius:8.0;" />

                        <Label fx:id="lblCarro4Title" style="-fx-font-weight:bold; -fx-font-size:15.0px;" text="Modelo — Placa" />

                        <Label fx:id="lblCarro4Info" style="-fx-font-size:12.0px;" text="Información" wrapText="true" />

                    </VBox>


                    <!-- CARD 5 -->
                    <VBox fx:id="card5" prefWidth="240.0" spacing="10.0" style="-fx-background-color:#ffffff; -fx-border-color:#e6e6e6; -fx-border-radius:10.0; -fx-background-radius:10.0; -fx-padding:12.0;">

                        <Region prefHeight="120.0" style="-fx-background-color:#f4f4f4; -fx-border-radius:8.0; -fx-background-radius:8.0;" />

                        <Label fx:id="lblCarro5Title" style="-fx-font-weight:bold; -fx-font-size:15.0px;" text="Modelo — Placa" />

                        <Label fx:id="lblCarro5Info" style="-fx-font-size:12.0px;" text="Información" wrapText="true" />

                    </VBox>


                </HBox>
            </content>

        </ScrollPane>
    </children>

</AnchorPane>
