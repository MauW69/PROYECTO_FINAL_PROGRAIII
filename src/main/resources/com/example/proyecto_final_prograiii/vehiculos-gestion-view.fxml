<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_final_prograiii.controllers.EmpleadoGestionVehiculosController"
            prefWidth="900" prefHeight="600">
    <children>
        <VBox spacing="8" AnchorPane.topAnchor="8" AnchorPane.leftAnchor="8" AnchorPane.rightAnchor="8" AnchorPane.bottomAnchor="8">
            <HBox spacing="8">
                <Button fx:id="btnRefrescar" text="Refrescar" onAction="#refrescarOnAction"/>
                <Button fx:id="btnAgregar" text="Agregar" onAction="#agregarOnAction"/>
                <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarOnAction"/>
            </HBox>

            <TableView fx:id="tblVehiculos" prefHeight="520" prefWidth="880">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colModelo" text="Modelo" prefWidth="150"/>
                    <TableColumn fx:id="colPlaca" text="Placa" prefWidth="100"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                    <TableColumn fx:id="colYear" text="Año" prefWidth="80"/>
                    <TableColumn fx:id="colColor" text="Color" prefWidth="100"/>
                    <TableColumn fx:id="colKm" text="Kilometraje" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    <TableColumn fx:id="colEditar" text="Editar" prefWidth="90"/>
                    <TableColumn fx:id="colEliminar" text="Eliminar" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
