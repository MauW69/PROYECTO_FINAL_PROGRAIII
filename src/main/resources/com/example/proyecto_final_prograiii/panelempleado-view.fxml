<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyecto_final_prograiii.controllers.PanelEmpleadoController">
    <children>
        <Label fx:id="lblBienvenida" layoutX="266.0" layoutY="14.0" text="BIENVENIDO" />
        <Button fx:id="btnCerrarSesion" layoutX="25.0" layoutY="19.0" mnemonicParsing="false"
                onAction="#cerrarOnAction" prefHeight="25.0" prefWidth="122.0" text="CERRAR SESION" />
        <Button fx:id="agregarBtn" layoutX="229.0" layoutY="81.0" mnemonicParsing="false"
                onAction="#agregarOnAction" prefHeight="25.0" prefWidth="140.0" text="AGREGAR VEHICULO" />
        <!-- NUEVO: boton para abrir la gestion/edicion de vehiculos -->
        <Button fx:id="btnGestionar" layoutX="229.0" layoutY="120.0" mnemonicParsing="false"
                onAction="#gestionarOnAction" prefHeight="25.0" prefWidth="200.0" text="GESTIONAR VEHÍCULOS" />
    </children>
</AnchorPane>
