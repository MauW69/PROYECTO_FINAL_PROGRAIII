<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="535.0" prefWidth="1004.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_final_prograiii.controllers.PanelEmpleadoController">
    <children>
        <Label fx:id="lblBienvenida" layoutX="266.0" layoutY="14.0" text="BIENVENIDO" />
        <Button fx:id="btnCerrarSesion" layoutX="23.0" layoutY="23.0" mnemonicParsing="false" onAction="#cerrarOnAction" prefHeight="25.0" prefWidth="122.0" text="CERRAR SESION" />
        <Button fx:id="agregarBtn" layoutX="14.0" layoutY="76.0" mnemonicParsing="false" onAction="#agregarOnAction" prefHeight="25.0" prefWidth="140.0" text="AGREGAR VEHICULO" />
        <!-- NUEVO: boton para abrir la gestion/edicion de vehiculos -->
        <Button fx:id="btnGestionar" layoutX="463.0" layoutY="63.0" mnemonicParsing="false" onAction="#gestionarOnAction" prefHeight="26.0" prefWidth="122.0" text="GESTIONAR VEHÍCULOS" />
      <TabPane layoutX="36.0" layoutY="120.0" prefHeight="374.0" prefWidth="885.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="HISTORIAL">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tblHistorial" layoutX="-2.0" prefHeight="338.0" prefWidth="886.0">
                           <columns>
                              <TableColumn fx:id="colVehiculoHistorial" prefWidth="74.4000244140625" text="Vehiculo" />
                              <TableColumn fx:id="colClienteHistorial" prefWidth="87.19999694824219" text="Cliente" />
                              <TableColumn fx:id="colFechaInicioHistorial" prefWidth="106.39996337890625" text="Fecha Inicio" />
                              <TableColumn fx:id="colFechaFinHistorial" prefWidth="128.0" text="Fecha Fin" />
                              <TableColumn fx:id="colDiasTotalesHistorial" prefWidth="72.79998779296875" text="Dias totales" />
                              <TableColumn fx:id="colPrecioHistorial" prefWidth="92.79998779296875" text="Precio" />
                              <TableColumn fx:id="colEstadoHistorial" prefWidth="92.7999267578125" text="Estado" />
                              <TableColumn fx:id="colDetalleHistorial" prefWidth="140.79998779296875" text="Ver Detalles" />
                              <TableColumn fx:id="colBorrarHistorial" prefWidth="108.800048828125" text="Cancelar" />
                           </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
      <Button fx:id="btnCalendario" layoutX="737.0" layoutY="64.0" mnemonicParsing="false" onAction="#AbrirCalendario" prefHeight="26.0" prefWidth="82.0" text="Calendario" />
    </children>
</AnchorPane>
