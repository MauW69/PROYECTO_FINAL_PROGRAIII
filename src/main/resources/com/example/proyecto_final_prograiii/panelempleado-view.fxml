<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="509.0" prefWidth="1004.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_final_prograiii.controllers.PanelEmpleadoController">
    <children>
        <Label fx:id="lblBienvenida" layoutX="266.0" layoutY="14.0" text="BIENVENIDO" />
        <Button fx:id="btnCerrarSesion" layoutX="23.0" layoutY="23.0" mnemonicParsing="false" onAction="#cerrarOnAction" prefHeight="25.0" prefWidth="122.0" text="CERRAR SESION" />
        <Button fx:id="agregarBtn" layoutX="29.0" layoutY="102.0" mnemonicParsing="false" onAction="#agregarOnAction" prefHeight="25.0" prefWidth="140.0" text="AGREGAR VEHICULO" />
        <!-- NUEVO: boton para abrir la gestion/edicion de vehiculos -->
        <Button fx:id="btnGestionar" layoutX="29.0" layoutY="141.0" mnemonicParsing="false" onAction="#gestionarOnAction" prefHeight="25.0" prefWidth="200.0" text="GESTIONAR VEHÍCULOS" />
      <TabPane layoutX="267.0" layoutY="102.0" prefHeight="374.0" prefWidth="675.0" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          <Tab text="SOLICITUDES">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tblSolicitudes" prefHeight="338.0" prefWidth="675.0">
                           <columns>
                              <TableColumn fx:id="colVehiculoSolicitud" prefWidth="92.800048828125" text="Vehiculo" />
                              <TableColumn fx:id="colClienteSolicitud" prefWidth="84.0" text="Cliente" />
                              <TableColumn fx:id="colFechaInicioSolicitud" prefWidth="105.60003662109375" text="Fecha Inicio" />
                              <TableColumn fx:id="colPrecioSolicitud" prefWidth="83.199951171875" text="Precio" />
                              <TableColumn fx:id="colEstadoSolicitud" prefWidth="106.39996337890625" text="Estado" />
                              <TableColumn fx:id="colDetalleSolicitud" prefWidth="92.0" text="Ver Detalles" />
                              <TableColumn fx:id="colCancelarSolicitud" prefWidth="117.60009765625" text="Cancelar" />
                           </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
          <Tab text="HISTORIAL">
            <content>
              <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                     <children>
                        <TableView fx:id="tblHistorial" prefHeight="338.0" prefWidth="653.0">
                           <columns>
                              <TableColumn fx:id="colIdHistorial" prefWidth="75.0" text="ID" />
                              <TableColumn fx:id="colVehiculoHistorial" prefWidth="93.60003662109375" text="Vehiculo" />
                              <TableColumn fx:id="colFechainicioHistorial" prefWidth="91.199951171875" text="Fecha inicio" />
                              <TableColumn fx:id="colFechafinHistorial" prefWidth="119.20001220703125" text="Fecha fin" />
                              <TableColumn fx:id="colTotalPagadoHistorial" prefWidth="91.20001220703125" text="Total Pagado" />
                              <TableColumn fx:id="colEstadoHistorial" prefWidth="75.20001220703125" text="Estado" />
                              <TableColumn fx:id="colMetodoPagoHistorial" prefWidth="103.2000732421875" text="Metodo de pago" />
                           </columns>
                        </TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
        </tabs>
      </TabPane>
    </children>
</AnchorPane>
